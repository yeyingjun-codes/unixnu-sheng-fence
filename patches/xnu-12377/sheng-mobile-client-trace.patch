+volatile uint32_t native_mobile_client_last_selector;
+volatile uint32_t native_mobile_client_last_status;
+volatile uint32_t native_mobile_client_selector_status[96];
+volatile uint32_t native_mobile_client_selector_pid[96];
+volatile uint32_t native_mobile_client_selector_struct_size[96];
